name: Production Gated CI/CD Pipeline

on:
  push:
    branches: [ main ]
    tags:
      - 'v*' # Triggers on releases (e.g., v1.0.0)
  pull_request:
    branches: [ main ]

env:
  FRONTEND_IMAGE: kubenix/infraops-frontend
  BACKEND_IMAGE: kubenix/infraops-backend
  DOCKER_REGISTRY: docker.io
  DOCKER_ORG: myorg
  SONAR_PROJECT_KEY: infraops-portal

jobs:
  # =========================================================================
  # GATE 1: CODE VERIFICATION, COMPILATION & TESTING
  # =========================================================================
  build-and-test:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Source Code
        uses: actions/checkout@v4

      - name: Setup Node.js Environment
        uses: actions/setup-node@v4
        with:
          node-version: '22'

      - name: Install Frontend Dependencies
        working-directory: frontend
        run: |
          if [ -f package-lock.json ]; then
            npm ci
          else
            npm install
          fi

      - name: Run Frontend Linter (Syntax Gate)
        working-directory: frontend
        run: npm run lint

      - name: Build Frontend
        working-directory: frontend
        run: npm run build

      - name: Setup Python Environment
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Install Backend Dependencies
        working-directory: backend
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
          pip install pytest pytest-cov

      - name: Run Backend Unit Tests with Coverage
        working-directory: backend
        env:
          PYTHONPATH: .
        run: pytest --cov=.

  # =========================================================================
  # GATE 2: PRE-BUILD SECURITY SCANNING
  # =========================================================================
  static-security:
    needs: build-and-test
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Source Code
        uses: actions/checkout@v4

      - name: Gitleaks Secret Scan Gate
        uses: gitleaks/gitleaks-action@v2
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Hadolint Frontend Dockerfile Scan
        uses: hadolint/hadolint-action@v3.3.0
        with:
          dockerfile: frontend/Dockerfile

      - name: Hadolint Backend Dockerfile Scan
        uses: hadolint/hadolint-action@v3.3.0
        with:
          dockerfile: backend/Dockerfile

      - name: Trivy Filesystem Scan Gate
        uses: aquasecurity/trivy-action@v0.28.0
        with:
          scan-type: 'fs'
          scan-ref: '.'
          exit-code: '1'
          severity: 'HIGH,CRITICAL'

  # =========================================================================
  # GATE 3: DEEP CODE QUALITY SCANNING
  # =========================================================================
  code-quality:
    needs: static-security
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Source Code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: SonarQube Scan Gate
        uses: sonarsource/sonarqube-scan-action@v3
        env:
          SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}
          SONAR_HOST_URL: ${{ secrets.SONAR_HOST_URL }}
        with:
          args: >
            -Dsonar.qualitygate.wait=true
            -Dsonar.projectKey=${{ env.SONAR_PROJECT_KEY }}

  # =========================================================================
  # GATE 4: CONTAINERIZATION & IMAGE VULNERABILITY SCANNING
  # =========================================================================
  container-security:
    needs: code-quality
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Source Code
        uses: actions/checkout@v4

      # 🌟 FIX: Compute the version tag and inject into the pipeline runner environment
      - name: Set Dynamic Image Tag
        run: |
          if [ "${{ github.ref_type }}" = "tag" ]; then
            echo "IMAGE_TAG=${{ github.ref_name }}" >> $GITHUB_ENV
          else
            echo "IMAGE_TAG=${{ github.sha }}" >> $GITHUB_ENV
          fi

      - name: Build Frontend Docker Image Locally
        run: |
          docker build -t ${{ env.FRONTEND_IMAGE }}:${{ env.IMAGE_TAG }} -f frontend/Dockerfile frontend

      - name: Build Backend Docker Image Locally
        run: |
          docker build -t ${{ env.BACKEND_IMAGE }}:${{ env.IMAGE_TAG }} -f backend/Dockerfile backend

      - name: Trivy Frontend Image Scan Gate
        uses: aquasecurity/trivy-action@v0.28.0
        with:
          image-ref: ${{ env.FRONTEND_IMAGE }}:${{ env.IMAGE_TAG }}
          format: 'table'
          exit-code: '1'
          ignore-unfixed: true
          severity: 'CRITICAL,HIGH'

      - name: Trivy Backend Image Scan Gate
        uses: aquasecurity/trivy-action@v0.28.0
        with:
          image-ref: ${{ env.BACKEND_IMAGE }}:${{ env.IMAGE_TAG }}
          format: 'table'
          exit-code: '1'
          ignore-unfixed: true
          severity: 'CRITICAL,HIGH'

      - name: Log in to Registry & Push Images
        run: |
          echo "${{ secrets.REGISTRY_PASSWORD }}" | docker login -u "${{ secrets.REGISTRY_USERNAME }}" "${{ env.DOCKER_REGISTRY }}"
          
          # Tag and push frontend
          docker tag ${{ env.FRONTEND_IMAGE }}:${{ env.IMAGE_TAG }} "${{ env.DOCKER_REGISTRY }}/${{ env.DOCKER_ORG }}/infraops-frontend:${{ env.IMAGE_TAG }}"
          docker push "${{ env.DOCKER_REGISTRY }}/${{ env.DOCKER_ORG }}/infraops-frontend:${{ env.IMAGE_TAG }}"
          
          # Tag and push backend
          docker tag ${{ env.BACKEND_IMAGE }}:${{ env.IMAGE_TAG }} "${{ env.DOCKER_REGISTRY }}/${{ env.DOCKER_ORG }}/infraops-backend:${{ env.IMAGE_TAG }}"
          docker push "${{ env.DOCKER_REGISTRY }}/${{ env.DOCKER_ORG }}/infraops-backend:${{ env.IMAGE_TAG }}"

  # =========================================================================
  # GATE 5: STAGING DEPLOYMENT & E2E RUNS
  # =========================================================================
  staging-deployment:
    needs: container-security
    runs-on: ubuntu-latest
    environment: staging
    steps:
      - name: Checkout Source Code
        uses: actions/checkout@v4

      # 🌟 FIX: Compute the version tag for the staging context
      - name: Set Dynamic Image Tag
        run: |
          if [ "${{ github.ref_type }}" = "tag" ]; test
            echo "IMAGE_TAG=${{ github.ref_name }}" >> $GITHUB_ENV
          else
            echo "IMAGE_TAG=${{ github.sha }}" >> $GITHUB_ENV
          fi

      - name: Deploy to Staging Cluster
        run: |
          echo "Deploying applications to Staging..."
          echo "Using Version Tag: ${{ env.IMAGE_TAG }}"
          # Insert your staging helm upgrade or kubectl apply commands here

      - name: Run Cypress End-to-End Tests (Integration Gate)
        uses: cypress-io/github-action@v6
        with:
          wait-on: 'https://staging.infraops.yourcompany.com' # Updated placeholder to match a staging endpoint
          wait-on-timeout: 120

  # =========================================================================
  # GATE 6: PRODUCTION DEPLOYMENT (Requires manual validation button)
  # =========================================================================
  production-deployment:
    needs: staging-deployment
    runs-on: ubuntu-latest
    environment:
      name: production
      url: https://myapp.com
    steps:
      - name: Checkout Source Code
        uses: actions/checkout@v4

      # 🌟 FIX: Compute the version tag for the production context
      - name: Set Dynamic Image Tag
        run: |
          if [ "${{ github.ref_type }}" = "tag" ]; then
            echo "IMAGE_TAG=${{ github.ref_name }}" >> $GITHUB_ENV
          else
            echo "IMAGE_TAG=${{ github.sha }}" >> $GITHUB_ENV
          fi

      - name: Deploy to Production
        run: |
          echo "Gates completely cleared! Deploying tag/sha ${{ env.IMAGE_TAG }} to Production."
          # Insert your production zero-downtime deployment commands here
