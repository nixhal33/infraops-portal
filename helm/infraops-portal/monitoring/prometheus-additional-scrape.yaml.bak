apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: infraops-backend-monitor
  namespace: observability
  labels:
    release: kube-prometheus-stack # standard label for MicroK8s observability to find it
spec:
  selector:
    matchLabels:
      app: infraops-backend # Make sure this matches the label on your app's Service (SVC)
  namespaceSelector:
    matchNames:
      - infraops # The namespace where your backend app runs
  endpoints:
  - port: http # The name of the port defined in your backend Service definition
    path: /api/observability/metrics

